# REDIS_1_PORT=46379
# REDIS_1_USERNAME=default
# REDIS_1_PASSWORD=lkmnBio27
# REDIS_1_DB=1
# REDIS_2_HOST=127.0.0.1
# REDIS_2_PORT=46379
# REDIS_2_USERNAME=default
# REDIS_2_PASSWORD=lkmnBio27
# REDIS_2_DB=1
